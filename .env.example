# Required in every environment. Generate a long random value and keep it secret.
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Session duration for new logins. Defaults to 7 days.
JWT_EXPIRES_IN=7d

# Optional. Comma-separated external browser origins allowed to call the API.
# The deployed UI on the same domain is allowed automatically, so this can remain empty.
CORS_ORIGINS=https://your-app.up.railway.app

# External AI is fail-closed. Enable only after privacy/legal approval.
AI_EXTERNAL_PROCESSING_ENABLED=false

# Configure only the provider selected in the administration panel.
# Keep these values in the deployment secret manager; never store them in the app database.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
